// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContactMessageStatus {
  NEW
  CONTACTED
  CLOSED
}

model ContactMessage {
  id          String               @id @default(uuid()) @db.Uuid
  referenceId String               @unique @map("reference_id") @db.VarChar(32)
  name        String               @db.VarChar(80)
  phone       String               @db.VarChar(20)
  email       String               @db.VarChar(120)
  message     String               @db.Text
  status      ContactMessageStatus @default(NEW)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status], map: "message_from_contact_us_status_idx")
  @@index([createdAt], map: "message_from_contact_us_created_at_idx")
  @@map("message_from_contact_us")
}
